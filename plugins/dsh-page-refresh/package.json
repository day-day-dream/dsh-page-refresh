{
  "name": "dsh-page-refresh",
  "description": "Refresh button and a power menu (restart / close DeepSeek Harness) in the conversation header. Client-only, zero tokens, no dependencies.",
  "version": "1.2.1",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/day-day-dream/dsh-page-refresh.git"
  },
  "homepage": "https://github.com/day-day-dream/dsh-page-refresh",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reload",
    "refresh"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
